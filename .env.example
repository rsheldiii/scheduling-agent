# ── Required ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_twilio_auth_token
PHONE_NUMBER_FROM=+14155551234
DOMAIN=your-subdomain.ngrok-free.dev
USER_INFO_SECRET=your_encryption_password

# ── Optional ─────────────────────────────────────────────────────────

# Bearer token for /prompts and /outgoing-call endpoints.
# Also used as the password for the chat UI login screen.
# If omitted, a random token is generated and logged on startup.
# API_BEARER_TOKEN=your_api_token

# Secret used to sign Chainlit session JWTs (required for chat UI auth).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
CHAINLIT_AUTH_SECRET=your_chainlit_auth_secret

# Google Calendar integration (omit to disable calendar features)
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CREDENTIALS=credentials.json

# Set to "false" to skip Twilio signature validation (local dev only)
TWILIO_SIGNATURE_VALIDATION=true

# Override the default Realtime API voice (default: cedar)
# REALTIME_VOICE=cedar

# Server port (default: 2255)
# PORT=2255
